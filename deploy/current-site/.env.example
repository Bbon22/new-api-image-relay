# Copy this file to .env and replace every placeholder before starting the stack.
# Generate each secret independently with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
SESSION_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX
CRYPTO_SECRET=REPLACE_WITH_ANOTHER_RANDOM_HEX

# Public origin of the site. Keep the HTTPS origin aligned with the reverse proxy.
SITE_ORIGIN=https://zmw.bon2.space
TASK_PUBLIC_ADDRESS=https://zmw.bon2.space
TRUSTED_PROXIES=127.0.0.1,172.18.0.0/16
TASK_ARTIFACT_SIGNING_KEY_VERSION=1
TASK_HEARTBEAT_URL=

# Use false and http://localhost:3000 only for local, non-production testing.
SESSION_COOKIE_SECURE=true
APP_HOST_PORT=3000
